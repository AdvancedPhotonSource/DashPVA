      <item row="2" column="0">
       <widget class="QLabel" name="lbl_h">
        <property name="text">
         <string>H:</string>
        </property>
       </widget>
      </item>
      <item row="2" column="1">
       <widget class="QDoubleSpinBox" name="spn_hmin">
        <property name="enabled">
