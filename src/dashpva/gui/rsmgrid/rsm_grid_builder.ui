      </item>
      <item row="0" column="3" rowspan="5">
       <widget class="GridBoxPreview" name="preview_box" native="true"/>
      </item>
     </layout>
    </widget>
   </item>

   <item>
    <widget class="QGroupBox" name="grp_grid">
     <property name="title">
      <string>Grid Resolution</string>
     </property>
     <layout class="QGridLayout" name="gridLayout_grid">      <item row="0" column="0">
       <widget class="QComboBox" name="cmb_resolution_units">
        <property name="toolTip">
         <string>Unit the resolution is expressed in</string>
        </property>
        <item>
         <property name="text">
          <string>voxels</string>
         </property>
        </item>
        <item>
         <property name="text">
          <string>px</string>
         </property>
        </item>
       </widget>
      </item>
      <item row="0" column="1">
       <widget class="QLabel" name="lbl_resolution">
        <property name="text">
         <string>Resolution:</string>
        </property>
       </widget>
      </item>
      <item row="0" column="3" colspan="3">
       <widget class="QCheckBox" name="chk_per_axis">
        <property name="text">
         <string>Per-axis (set H, K, L separately)</string>
        </property>
        <property name="checked">
         <bool>false</bool>
        </property>
       </widget>
      </item>
      <item row="0" column="2">
       <widget class="QSpinBox" name="spn_resolution">
        <property name="alignment">
         <set>Qt::AlignRight|Qt::AlignVCenter</set>
        </property>
        <property name="minimumWidth">
         <number>130</number>
        </property>
        <property name="maximumWidth">
         <number>130</number>
        </property>
        <property name="suffix">
         <string> voxels</string>
        </property>
        <property name="minimum">
         <number>2</number>
        </property>
        <property name="maximum">
         <number>2000</number>
        </property>
        <property name="value">
         <number>200</number>
        </property>
       </widget>
      </item>

      <item row="1" column="0">
       <widget class="QLabel" name="lbl_nx">
        <property name="text">
         <string>H:</string>
        </property>
       </widget>
      </item>
      <item row="1" column="1">
       <widget class="QSpinBox" name="spn_nx">
        <property name="alignment">
         <set>Qt::AlignRight|Qt::AlignVCenter</set>
        </property>
        <property name="minimumWidth">
         <number>130</number>
        </property>
        <property name="maximumWidth">
         <number>130</number>
        </property>
        <property name="suffix">
         <string> voxels</string>
        </property>
        <property name="minimum">
         <number>2</number>
        </property>
        <property name="maximum">
         <number>2000</number>
        </property>
        <property name="value">
         <number>200</number>
        </property>
       </widget>
      </item>
      <item row="1" column="2">
       <widget class="QLabel" name="lbl_ny">
        <property name="text">
         <string>K:</string>
        </property>
       </widget>
      </item>
      <item row="1" column="3">
       <widget class="QSpinBox" name="spn_ny">
        <property name="alignment">
         <set>Qt::AlignRight|Qt::AlignVCenter</set>
        </property>
        <property name="minimumWidth">
         <number>130</number>
        </property>
        <property name="maximumWidth">
         <number>130</number>
        </property>
        <property name="suffix">
         <string> voxels</string>
        </property>
        <property name="minimum">
         <number>2</number>
        </property>
        <property name="maximum">
         <number>2000</number>
        </property>
        <property name="value">
         <number>200</number>
        </property>
       </widget>
      </item>
      <item row="1" column="4">
       <widget class="QLabel" name="lbl_nz">
        <property name="text">
         <string>L:</string>
        </property>
       </widget>
      </item>
      <item row="1" column="5">
       <widget class="QSpinBox" name="spn_nz">
        <property name="alignment">
         <set>Qt::AlignRight|Qt::AlignVCenter</set>
        </property>
        <property name="minimumWidth">
         <number>130</number>
        </property>
        <property name="maximumWidth">
         <number>130</number>
        </property>
        <property name="suffix">
         <string> voxels</string>
        </property>
        <property name="minimum">
         <number>2</number>
        </property>
        <property name="maximum">
         <number>2000</number>
        </property>
        <property name="value">
         <number>200</number>
        </property>
       </widget>
      </item>
      <item row="2" column="0" colspan="6">
       <widget class="QCheckBox" name="chk_use_mask">
        <property name="text">
         <string>Apply active mask (excludes masked pixels entirely, never zeroes them)</string>
        </property>
        <property name="checked">
         <bool>true</bool>
        </property>
       </widget>
      </item>
      <item row="3" column="0" colspan="6">
       <widget class="QCheckBox" name="chk_mask_transposed">
        <property name="text">
         <string>Mask was made with the viewer transposed</string>
        </property>
        <property name="toolTip">
         <string>The in-app mask is stored in the viewer's display orientation, which is not recorded in the file. Tick this if the viewer's transpose was on when the mask was created, otherwise the wrong pixels are masked.</string>
        </property>
        <property name="checked">
         <bool>false</bool>
        </property>
       </widget>
      </item>
      <item row="4" column="0">
       <widget class="QLabel" name="lbl_monitor">
        <property name="text">
         <string>Normalize by:</string>
        </property>
       </widget>
      </item>
      <item row="4" column="1" colspan="5">
       <widget class="QComboBox" name="cmb_monitor">
        <property name="toolTip">
         <string>Per-frame monitor (I0) signal from entry/data/metadata/ca/. Without it, scans taken at different exposure or attenuation will not match in intensity where they overlap.</string>
        </property>
       </widget>
      </item>
      <item row="5" column="0" colspan="6">
       <widget class="QLabel" name="lbl_memory_estimate">
        <property name="text">
         <string>Estimated peak RAM: calculating…</string>
        </property>
        <property name="wordWrap">
         <bool>true</bool>
        </property>
       </widget>
      </item>
