<ui version="4.0">
 <class>RSMGridBuilderDialog</class>
 <widget class="QDialog" name="RSMGridBuilderDialog">
  <property name="geometry">
   <rect>
    <x>0</x>
    <y>0</y>
    <width>640</width>
    <height>620</height>
   </rect>
  </property>
  <property name="windowTitle">
   <string>RSM Volume Builder</string>
  </property>
  <layout class="QVBoxLayout" name="verticalLayout">
   <item>
    <widget class="QLabel" name="lbl_desc">
     <property name="text">
      <string>Merge one or more scan HDF5 files into a single gridded 3D reciprocal-space volume (rsMap3D-style). Add every file that is part of the same crystal orientation/energy; merging inconsistent scans is rejected.</string>
     </property>
     <property name="wordWrap">
      <bool>true</bool>
     </property>
    </widget>
   </item>

   <item>
    <widget class="QGroupBox" name="grp_files">
     <property name="title">
      <string>Input Scan Files</string>
     </property>
     <layout class="QVBoxLayout" name="verticalLayout_files">
      <item>
       <widget class="QListWidget" name="lst_files">
        <property name="selectionMode">
         <enum>QAbstractItemView::ExtendedSelection</enum>
        </property>
       </widget>
      </item>
      <item>
       <layout class="QHBoxLayout" name="horizontalLayout_file_buttons">
        <item>
         <widget class="QPushButton" name="btn_add_files">
          <property name="text">
           <string>Add Files…</string>
          </property>
         </widget>
        </item>
        <item>
         <widget class="QPushButton" name="btn_remove_file">
          <property name="text">
           <string>Remove Selected</string>
          </property>
         </widget>
        </item>
        <item>
         <spacer name="horizontalSpacer_files">
          <property name="orientation">
           <enum>Qt::Horizontal</enum>
          </property>
         </spacer>
        </item>
       </layout>
      </item>
     </layout>
    </widget>
   </item>

   <item>
    <widget class="QGroupBox" name="grp_grid">
     <property name="title">
      <string>Grid Resolution</string>
     </property>
     <layout class="QGridLayout" name="gridLayout_grid">
      <item row="0" column="0">
       <widget class="QLabel" name="lbl_nx">
        <property name="text">
         <string>nx:</string>
        </property>
       </widget>
      </item>
      <item row="0" column="1">
       <widget class="QSpinBox" name="spn_nx">
        <property name="minimum">
         <number>2</number>
        </property>
        <property name="maximum">
         <number>2000</number>
        </property>
        <property name="value">
         <number>200</number>
        </property>
       </widget>
      </item>
      <item row="0" column="2">
       <widget class="QLabel" name="lbl_ny">
        <property name="text">
         <string>ny:</string>
        </property>
       </widget>
      </item>
      <item row="0" column="3">
       <widget class="QSpinBox" name="spn_ny">
        <property name="minimum">
         <number>2</number>
        </property>
        <property name="maximum">
         <number>2000</number>
        </property>
        <property name="value">
         <number>200</number>
        </property>
       </widget>
      </item>
      <item row="0" column="4">
       <widget class="QLabel" name="lbl_nz">
        <property name="text">
         <string>nz:</string>
        </property>
       </widget>
      </item>
      <item row="0" column="5">
       <widget class="QSpinBox" name="spn_nz">
        <property name="minimum">
         <number>2</number>
        </property>
        <property name="maximum">
         <number>2000</number>
        </property>
        <property name="value">
         <number>200</number>
        </property>
       </widget>
      </item>
      <item row="1" column="0" colspan="6">
       <widget class="QCheckBox" name="chk_use_mask">
        <property name="text">
         <string>Apply active mask (excludes masked pixels entirely, never zeroes them)</string>
        </property>
        <property name="checked">
         <bool>true</bool>
        </property>
       </widget>
      </item>
      <item row="2" column="0" colspan="6">
       <widget class="QCheckBox" name="chk_mask_transposed">
        <property name="text">
         <string>Mask was made with the viewer transposed</string>
        </property>
        <property name="toolTip">
         <string>The in-app mask is stored in the viewer's display orientation, which is not recorded in the file. Tick this if the viewer's transpose was on when the mask was created, otherwise the wrong pixels are masked.</string>
        </property>
        <property name="checked">
         <bool>false</bool>
        </property>
       </widget>
      </item>
      <item row="3" column="0">
       <widget class="QLabel" name="lbl_monitor">
        <property name="text">
         <string>Normalize by:</string>
        </property>
       </widget>
      </item>
      <item row="3" column="1" colspan="5">
       <widget class="QComboBox" name="cmb_monitor">
        <property name="toolTip">
         <string>Per-frame monitor (I0) signal from entry/data/metadata/ca/. Without it, scans taken at different exposure or attenuation will not match in intensity where they overlap.</string>
        </property>
       </widget>
      </item>
     </layout>
    </widget>
   </item>

   <item>
    <widget class="QGroupBox" name="grp_output">
     <property name="title">
      <string>Output</string>
     </property>
     <layout class="QHBoxLayout" name="horizontalLayout_output">
      <item>
       <widget class="QLineEdit" name="txt_output_file"/>
      </item>
      <item>
       <widget class="QPushButton" name="btn_browse_output">
        <property name="text">
         <string>Browse…</string>
        </property>
       </widget>
      </item>
     </layout>
    </widget>
   </item>

   <item>
    <widget class="QProgressBar" name="progress_bar">
     <property name="value">
      <number>0</number>
     </property>
    </widget>
   </item>

   <item>
    <widget class="QTextEdit" name="txt_log">
     <property name="readOnly">
      <bool>true</bool>
     </property>
    </widget>
   </item>

   <item>
    <layout class="QHBoxLayout" name="horizontalLayout_actions">
     <item>
      <widget class="QPushButton" name="btn_start">
       <property name="text">
        <string>Start</string>
       </property>
      </widget>
     </item>
     <item>
      <widget class="QPushButton" name="btn_cancel">
       <property name="text">
        <string>Cancel</string>
       </property>
       <property name="enabled">
        <bool>false</bool>
       </property>
      </widget>
     </item>
     <item>
      <spacer name="horizontalSpacer_actions">
       <property name="orientation">
        <enum>Qt::Horizontal</enum>
       </property>
      </spacer>
     </item>
     <item>
      <widget class="QPushButton" name="btn_close">
       <property name="text">
        <string>Close</string>
       </property>
      </widget>
     </item>
    </layout>
   </item>
  </layout>
 </widget>
 <resources/>
 <connections/>
</ui>
